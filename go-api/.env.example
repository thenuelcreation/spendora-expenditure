APP_ENV=development
PORT=8080
DATABASE_URL=postgres://spendora:spendora@localhost:5432/spendora?sslmode=disable
# Use a long random value (32+ characters). Required in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated list of frontend origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:3000
# Set true only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=false
